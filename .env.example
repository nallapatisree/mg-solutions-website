# --- Database ---
# SQLite file path (relative to project root). No external DB server required.
DATABASE_PATH=./data/mgsolutions.db

# --- Auth ---
# Long random string used to sign admin JWT session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Session cookie lifetime, in hours
SESSION_HOURS=12

# --- First admin account bootstrap (used by `npm run create-admin`) ---
ADMIN_EMAIL=mgsolutionscareers@gmail.com
ADMIN_PASSWORD=11421M&g

# --- File uploads ---
# Local folder (inside /public) that uploaded media is written to
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_MB=5

# --- Optional integrations (safe to leave blank in development) ---
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
